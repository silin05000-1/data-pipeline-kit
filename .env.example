# Скопируйте в .env и заполните свои значения.
# ВНИМАНИЕ: .env добавлен в .gitignore — никогда не коммитьте реальные секреты.

# REST API
API_TOKEN=replace-me
API_USERNAME=replace-me
API_PASSWORD=replace-me

# Telegram
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# Slack
SLACK_WEBHOOK_URL=replace-me

# SMTP (email)
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
